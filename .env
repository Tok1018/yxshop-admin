VITE_APP_TITLE = 远讯电商管理
VITE_APP_PORT = 5173
VITE_APP_BASE = /yxadmin/
VITE_APP_TOKEN_PREFIX = yxshop_admin_token

# Token 存储加密密钥（生产环境务必修改为随机字符串）
# 可用命令生成：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
VITE_APP_ENCRYPT_KEY = yxshop_open_source_default_key

# API 代理目标（开发环境指向后端 Webman 服务）
VITE_API_TARGET = http://127.0.0.1:8777
